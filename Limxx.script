local function showStatus()
    print("LIMXX SCRIPT is ready")
    print("Version:", Limxx.Version)
    print("Modules connected:", Modules ~= nil)
end

showStatus()
local function toggleFeature(name: string, enabled: boolean)
    if Features[name] ~= nil then
        Features[name] = enabled
        print(name, "=", enabled)
    end
end

toggleFeature("AutoRevive", false)
toggleFeature("AutoRespawn", false)
local Menu = {
    Open = false,
