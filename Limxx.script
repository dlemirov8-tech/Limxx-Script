}
function Menu:Toggle()
    if self.Open == true then
        self.Open = false
    else
        self.Open = true
    end

    print("Menu:", self.Open)
    function Menu:Toggle()
    if self.Open == true then
        self.Open = false
    else
        self.Open = true
    end

    print("Menu:", self.Open)
    end    end
    local function printSettings()
    print("=== LIMXX SETTINGS ===")
    print("WalkSpeed:", Settings.WalkSpeed)
    print("JumpPower:", Settings.JumpPower)
    print("Menu:", Menu.Open)
end

printSettings()
    local function setWalkSpeed(value: number)
    if value > 0 then
        Settings.WalkSpeed = value
        Movement.WalkSpeed = value
        print("WalkSpeed set to:", value)
    end
end

setWalkSpeed(16)
    local function setJumpPower(value: number)
    if value > 0 then
        Settings.JumpPower = value
        Movement.JumpPower = value
        print("JumpPower set to:", value)
    end
end

setJumpPower(50)
