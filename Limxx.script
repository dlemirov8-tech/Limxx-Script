local function showCategory(name: string, items: {string})
    print("=== " .. name .. " ===")

    for _, item in ipairs(items) do
        print("[ ] " .. item)
    end
end

showCategory("Movement", MenuActions.Movement)
showCategory("Visuals", MenuActions.Visuals)
showCategory("Teleports", MenuActions.Teleports)
    local function toggle(name: string, state: boolean)
    if state == true then
        print("[ON] " .. name)
    else
        print("[OFF] " .. name)
    end
end

toggle("WalkSpeed", true)
toggle("JumpPower", true)
toggle("InfiniteJump", false)
toggle("Fly", false)

toggle("PlayerESP", false)
toggle("BotESP", false)
toggle("ItemESP", false)
toggle("Fullbright", false)
toggle("NoFog", false)
    local SettingsMenu = {
    WalkSpeed = 16,
    JumpPower = 50,
    InfiniteJump = false,
    Fly = false,
}

local function setSetting(name: string, value: number)
    if name == "WalkSpeed" then
        SettingsMenu.WalkSpeed = value
    elseif name == "JumpPower" then
        SettingsMenu.JumpPower = value
    end

    print("[SETTING]", name, "=", value)
end

setSetting("WalkSpeed", 16)
setSetting("JumpPower", 50)

print("Settings menu loaded")
